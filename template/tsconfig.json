{
  "compilerOptions": {
    "target": "ES2020", "module": "Preserve", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "noEmit": true, "lib": ["dom", "dom.iterable", "esnext"],
    "esModuleInterop": true, "skipLibCheck": true, "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] }
  },
  "exclude": ["remotion.config.ts"]
}
